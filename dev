#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
compose() {
  if [ -f .env ]; then
    docker compose --env-file .env -p myims-rebuild-dev -f infra/docker/compose.yaml "$@"
  else
    docker compose -p myims-rebuild-dev -f infra/docker/compose.yaml "$@"
  fi
}
workspace_exec() {
  if [ -t 0 ] && [ -t 1 ]; then compose exec --user node workspace "$@";
  else compose exec -T --user node workspace "$@"; fi
}
prepare() {
  docker info --format '{{.ServerVersion}}' >/dev/null
  existing_storage=
  if docker volume inspect myims-rebuild-dev_garage-meta >/dev/null 2>&1; then existing_storage=--existing-storage; fi
  existing_database=
  if docker volume inspect myims-rebuild-dev_postgres-data >/dev/null 2>&1; then existing_database=--existing-database; fi
  docker run --rm --user "$(id -u):$(id -g)" --mount "type=bind,src=$(pwd),dst=/workspace" -w /workspace \
    node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c \
    node scripts/init-services.mjs $existing_database $existing_storage
  compose config --quiet
}
provision_storage() {
  [ "$#" -gt 0 ] || set -- scripts/provision-storage.mjs
  storage_docker_binary=$(command -v docker)
  docker run --rm --user "$(id -u):$(id -g)" --group-add "$(stat -c %g /var/run/docker.sock)" \
    -e "STORAGE_HOST_PROJECT_ROOT=$(pwd)" \
    --mount "type=bind,src=$(pwd),dst=/workspace" \
    --mount "type=bind,src=$storage_docker_binary,dst=/usr/bin/docker,readonly" \
    --mount type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock -w /workspace \
    node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c \
    node "$@"
}
action=${1:-help}
[ "$#" -eq 0 ] || shift
case "$action" in
  prepare) prepare ;;
  storage-provision) provision_storage ;;
  storage-deployment-check) workspace_exec pnpm build:backend; provision_storage scripts/check-storage-deployment.mjs ;;
  up) prepare; compose up -d --build --wait --wait-timeout 120 workspace
      provision_storage
      workspace_exec pnpm install --frozen-lockfile
      workspace_exec pnpm build:backend
      workspace_exec pnpm db:migrate
      compose up -d --force-recreate --wait --wait-timeout 120 backend
      echo 'Ready. Run ./dev command (http://localhost:3100), ./dev shell, or ./dev check.' ;;
  shell) workspace_exec bash ;;
  migrate) workspace_exec pnpm build:backend; workspace_exec pnpm db:migrate ;;
  bootstrap-operator) workspace_exec pnpm build:backend; workspace_exec pnpm --filter @myims/backend exec node dist/entrypoints/deployment/main.js bootstrap-operator "$@" ;;
  health) workspace_exec node scripts/health-status.mjs ;;
  foundation-check) workspace_exec pnpm check:foundation ;;
  backend) compose logs -f backend ;;
  worker-up) workspace_exec pnpm build:backend; workspace_exec pnpm db:migrate
      compose --profile workers up -d --scale "worker=${1:-1}" worker ;;
  worker-down) compose --profile workers stop worker ;;
  worker-logs) compose --profile workers logs -f worker ;;
  command|platform|public|responder|public-mobile)
      workspace_exec pnpm "dev:$action" ;;
  check) workspace_exec pnpm check; workspace_exec pnpm check:foundation; workspace_exec pnpm check:storage-clients; provision_storage scripts/check-storage-deployment.mjs; provision_storage scripts/check-session-deployment.mjs ;;
  exec) [ "$#" -gt 0 ] || { echo 'Usage: ./dev exec COMMAND [ARGS...]' >&2; exit 1; }
      if [ "$1" = pnpm ] && [ "${2:-}" = check:session-foundation ]; then
        shift 2
        if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --lifecycle ] && [ "$1" != --authority ]; }; then
          echo 'Supported session selections: --lifecycle, --authority' >&2; exit 1
        fi
        provision_storage scripts/check-session-deployment.mjs "$@"
      else workspace_exec "$@"; fi ;;
  status) compose --profile workspace ps ;;
  down) compose --profile workspace --profile workers down ;;
  *) echo 'Usage: ./dev {up|shell|command|platform|public|backend|responder|public-mobile|check|exec|status|down|prepare|migrate|bootstrap-operator|health|foundation-check|worker-up|worker-down|worker-logs|storage-provision|storage-deployment-check}'
     [ "$action" = help ] || exit 1 ;;
esac
