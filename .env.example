# Optional host port overrides. No credentials belong in this file.
MYIMS_WEB_BIND=127.0.0.1
# Set only this to 0.0.0.0 for command-center access through a server IP.
MYIMS_COMMAND_BIND=127.0.0.1
MYIMS_COMMAND_PORT=3100
MYIMS_PLATFORM_PORT=3101
MYIMS_PUBLIC_PORT=3102
MYIMS_BACKEND_PORT=4100
MYIMS_METRO_PORT=8081
MYIMS_DB_PORT=5433
MYIMS_SESSION_REDIS_PORT=6380
MYIMS_REALTIME_REDIS_PORT=6381
MYIMS_SIP_PORT=5062
MYIMS_STORAGE_PORT=3900

# Approved distributed admission. Only lower these ceilings; changes require
# coordinated replica rollout. 120/minute identity must be reviewed against real
# polling/operator/mobile traffic before production (see session runbook).
SESSION_TIMEOUT_MS=2000
SESSION_CONCURRENCY=4
LIMITER_CAPACITY=8192
# Empty trusts only the connection peer. Explicit IP/CIDR list, no hostname trust.
LIMITER_TRUSTED_PROXIES=
LIMITER_PLATFORM_SIGN_IN_SOURCE=60
LIMITER_PLATFORM_SIGN_IN_IDENTITY=10
LIMITER_PLATFORM_SIGN_IN_WINDOW_SECONDS=900
LIMITER_TENANT_SIGN_IN_SOURCE=60
LIMITER_TENANT_SIGN_IN_IDENTITY=10
LIMITER_TENANT_SIGN_IN_WINDOW_SECONDS=900
LIMITER_PLATFORM_PROTECTED_SOURCE=600
LIMITER_PLATFORM_PROTECTED_IDENTITY=120
LIMITER_PLATFORM_PROTECTED_WINDOW_SECONDS=60
LIMITER_TENANT_PROTECTED_SOURCE=600
LIMITER_TENANT_PROTECTED_IDENTITY=120
LIMITER_TENANT_PROTECTED_WINDOW_SECONDS=60

# Optional platform browser boundary; all empty disables it. Configure together
# only behind the HTTPS same-origin proxy documented in the auth runbook.
# Peers are exact IPs and must also appear in LIMITER_TRUSTED_PROXIES.
PLATFORM_AUTH_ORIGIN=
PLATFORM_AUTH_PROXY_PEERS=
# Provision distinct random 256-bit lowercase hex secrets privately.
PLATFORM_AUTH_PROXY_SECRET=
PLATFORM_AUTH_CSRF_SECRET=
