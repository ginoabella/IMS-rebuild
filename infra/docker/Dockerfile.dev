FROM node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl git gosu procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global pnpm@10.12.1
COPY infra/docker/workspace-entrypoint.sh /usr/local/bin/workspace-entrypoint
RUN chmod +x /usr/local/bin/workspace-entrypoint
WORKDIR /workspace
ENTRYPOINT ["workspace-entrypoint"]
CMD ["sleep", "infinity"]
