{
  "name": "myims",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "lint": "eslint scripts eslint.config.mjs && pnpm -r --workspace-concurrency=1 lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc --project scripts/ui/tsconfig.json",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check:entrypoints": "pnpm --filter @myims/backend build && node scripts/check-entrypoints.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm check:entrypoints && pnpm check:config",
    "dev:command": "pnpm --filter @myims/command-center-web dev",
    "dev:platform": "pnpm --filter @myims/platform-console-web dev",
    "dev:public": "pnpm --filter @myims/public-web dev",
    "dev:backend": "pnpm --filter @myims/backend dev:http",
    "dev:responder": "pnpm --filter @myims/responder-mobile dev",
    "dev:public-mobile": "pnpm --filter @myims/public-mobile dev",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "services:status": "node scripts/services.mjs status",
    "services:check": "node scripts/services.mjs check",
    "build:backend": "pnpm --filter @myims/config build && pnpm --filter @myims/contracts build && pnpm --filter @myims/backend build",
    "db:migrate": "pnpm --filter @myims/backend exec node dist/entrypoints/deployment/main.js migrate",
    "check:config": "pnpm --filter @myims/config build && node --test scripts/config.test.mjs",
    "check:foundation": "pnpm build:backend && node scripts/check-foundation.mjs && pnpm check:durability && pnpm check:storage && pnpm check:identity-foundation",
    "check:ui": "playwright test --config scripts/ui/playwright.config.ts",
    "check:audit-outbox": "pnpm build:backend && node scripts/check-audit-outbox.mjs",
    "check:worker-delivery": "pnpm build:backend && node scripts/check-worker-delivery.mjs",
    "check:durability": "pnpm build:backend && node scripts/check-audit-outbox.mjs && node scripts/check-worker-delivery.mjs --recovery",
    "check:storage": "pnpm build:backend && node scripts/check-storage.mjs && node scripts/check-storage-access.mjs",
    "check:storage-clients": "node scripts/check-storage-clients.mjs",
    "check:identity-foundation": "pnpm build:backend && node scripts/check-identity-foundation.mjs",
    "check:session-foundation": "pnpm build:backend && node scripts/check-session-foundation.mjs",
    "check:platform-auth": "pnpm build:backend && node scripts/check-platform-auth-selection.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
