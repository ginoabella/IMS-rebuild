{
  "name": "MyIMS development",
  "dockerComposeFile": "../infra/docker/compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "none",
  "initializeCommand": ["sh", "dev", "prepare"],
  "postCreateCommand": "pnpm install --frozen-lockfile && pnpm build:backend && pnpm db:migrate",
  "forwardPorts": [3000, 3001, 3002, 4000, 8081],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
